// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// One row per demo/customer tenant. The `slug` is the per-tenant transmitter
// identity used in every discovery/JWKS/stream URL: /t/{slug}/...
model Tenant {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  // Phase 0: plaintext bearer token ISC pastes into Receiver > Authentication
  // > API Token. Fine for local SQLite dev; before any real deployment this
  // must be hashed at rest like any other credential.
  apiToken  String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  signingKey SigningKey?
  streams    Stream[]
  auditLogs  AuditLog[]
}

// RS256 keypair used to sign outbound SETs for this tenant.
// privateKeySecretId references a row in Supabase Vault's vault.secrets
// table (accessed via lib/vault.ts, not a Prisma-managed model since Vault
// isn't part of this schema) -- the actual PEM never lives in a plain
// column. The old privateKeyPem column was dropped once a real signed send
// was verified working end-to-end against Vault (see
// scripts/validate_key_migration.sh) -- a manual pre-drop export of the one
// legacy key it held is kept outside the repo as a rollback safety net.
model SigningKey {
  id                  String   @id @default(cuid())
  tenantId            String   @unique
  tenant              Tenant   @relation(fields: [tenantId], references: [id])
  kid                 String   @unique
  privateKeySecretId  String?
  publicKeyJwk        String // JSON-stringified JWK, served at /.well-known/jwks.json
  createdAt           DateTime @default(now())
}

enum StreamStatus {
  enabled
  paused
  disabled
}

// A stream ISC creates against POST /t/{slug}/ssf/streams.
// deliveryEndpointUrl is supplied BY ISC when it creates the stream -- the
// transmitter must always push to this URL, never to a manually typed one.
model Stream {
  id                  String       @id @default(cuid())
  tenantId            String
  tenant              Tenant       @relation(fields: [tenantId], references: [id])
  deliveryEndpointUrl String
  eventsRequested     String // JSON-stringified array of CAEP event type URIs
  status              StreamStatus @default(enabled)
  authorizationHeader String? // if ISC supplied a bearer token for its delivery endpoint
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  auditLogs AuditLog[]
}

// A vendor/event scenario in the Simulator's catalog. Previously a hardcoded
// object in lib/catalog.ts -- moved to the DB so the Admin catalog page can
// add new vendors/events without a code change + redeploy (HANDOFF_RUNBOOK.md
// Section 7 item 6, "Admin catalog"). Not tenant-scoped: this project is
// single-tenant by design (lib/tenant.ts), so the catalog is one global list,
// same as the static file it replaces.
model VendorScenario {
  id                String   @id @default(cuid())
  // Stable slug used everywhere a scenario is referenced (Simulator select,
  // AuditLog.scenarioKey, API payloads) -- same role the object key played
  // in the old static lib/catalog.ts map.
  key               String   @unique
  vendor            String
  displayName       String
  triggerCode       String
  // One of lib/caep.ts's CAEP_EVENT_TYPES -- not a Prisma enum so adding a
  // scenario never requires a schema migration, only lib/caep.ts already
  // enforces the closed set of 5 at validation time.
  caepType          String
  // The event's required + optional claims (e.g. current_level/previous_level
  // for risk-level-change), JSON-shaped exactly like CaepEventInput["claims"].
  claims            Json
  // Mirrors CaepEventInput's optional fields (lib/caep.ts) -- vendor/
  // vendorEventType/recommendedAction are known to be stripped by ISC before
  // a Workflow ever sees them (kept for audit value only); reasonAdmin is an
  // official CAEP claim ISC does preserve.
  vendorEventType   String?
  recommendedAction String?
  reasonAdmin       String?
  reasonUser        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// Every send attempt, success or failure. Server-side, per Section 10 of the
// design doc -- this is the system-of-record independent of any one SE's
// browser session.
model AuditLog {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  streamId     String?
  stream       Stream?  @relation(fields: [streamId], references: [id])
  jti          String   @unique
  eventType    String
  subject      String
  // Which catalog scenario (lib/catalog.ts key) this send came from, if any --
  // lets the Simulator UI's History page show the actual vendor/event name
  // instead of just the CAEP type. Null for sends not triggered from a
  // catalog scenario (e.g. scripts/test-send.ts, verification SETs).
  scenarioKey  String?
  httpStatus   Int?
  responseBody String?
  success      Boolean
  createdAt    DateTime @default(now())
}
